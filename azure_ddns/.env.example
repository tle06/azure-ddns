# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit real credentials.

# Azure service principal credentials (or omit all three to fall back to
# DefaultAzureCredential, e.g. managed identity / az login on the host)
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret

# DNS zone/record to keep updated (used in docker-compose.yml command args)
AZURE_RESOURCE_GROUP=my-resource-group
AZURE_ZONE_NAME=example.com
AZURE_RECORD_NAME=home

# Container behavior
AZURE_DDNS_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
